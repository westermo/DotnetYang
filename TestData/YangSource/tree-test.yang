module tree-test {
    yang-version 1.1;
    namespace "urn:dotnet:yang:tree-test";
    prefix tt;

    container root {
        leaf name {
            type string;
        }
        leaf threshold {
            type uint32;
        }
        container nested {
            leaf value {
                type uint32;
            }
            // The nested container is only valid when 'name' is set on root.
            when "../name";
            // 'value' must not exceed 'threshold' on the parent root.
            must "value <= ../threshold" {
                error-message "value exceeds threshold";
                error-app-tag "value-too-big";
            }
        }
        list items {
            key "id";
            leaf id {
                type string;
            }
            leaf description {
                type string;
            }
            // Each item with id='admin' must have a description.
            must "id != 'admin' or description";
        }
        leaf-list tags {
            type string;
        }
        list pairs {
            key "a b";
            leaf a {
                type string;
            }
            leaf b {
                type uint32;
            }
            leaf note {
                type string;
            }
        }
        container counts {
            must "count(../items) > 0";
        }
        container abs-test {
            // Absolute path: /root/name must be set when this container exists.
            must "/root/name" {
                error-message "root name required for abs-test";
                error-app-tag "abs-test-no-name";
            }
        }
        container deep {
            container inner {
                leaf level {
                    type uint32;
                }
            }
        }
        container shape {
            leaf kind {
                type string;
            }
            // Child steps must navigate through the choice/case layers.
            must "not(radius) or radius < 100" {
                error-message "radius too large";
                error-app-tag "radius-too-large";
            }
            choice form {
                case circle {
                    // Context node is the nearest data ancestor ('shape').
                    when "kind = 'round'";
                    leaf radius {
                        type uint32;
                    }
                    leaf label {
                        // '..' skips the case/choice layers to reach 'shape'.
                        when "../kind = 'round'";
                        type string;
                    }
                }
                case square {
                    leaf side {
                        type uint32;
                    }
                }
            }
        }
        container gated {
            leaf flag {
                type boolean;
            }
            // RFC 7950 7.13: the 'when' on 'uses' applies to every node the
            // grouping contributes, with 'gated' as the context node.
            uses extra {
                when "flag = 'true'";
            }
        }
        container wrapped {
            uses toggle-group;
        }
        container xp {
            leaf kind {
                type string;
            }
            leaf cur-ref {
                // Path whose filter primary is current().
                when "current()/../kind = 'on'";
                type string;
            }
        }
    }

    // RFC 7950 7.21.5: the 'when' on an augment is evaluated with the augment
    // target as the context node, even when the target came from a grouping.
    augment "/tt:root/tt:wrapped/tt:settings" {
        when "../enabled = 'true'";
        leaf boost {
            type uint32;
        }
    }

    augment "/tt:root/tt:deep/tt:inner" {
        when "level > 5";
        leaf bonus {
            type string;
        }
    }

    grouping toggle-group {
        leaf enabled {
            type boolean;
        }
        container settings {
            leaf mode {
                type string;
            }
        }
    }

    grouping extra {
        leaf extra-val {
            type string;
        }
        container extra-c {
            leaf v {
                type string;
            }
        }
    }
}

